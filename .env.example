# ─── Supabase (Admin - Next.js) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Supabase (Mobile - Expo) ───────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── AI Chatbot (Groq - default, free) ──────────────────────
# Get a free key at: https://console.groq.com/keys
# Uses Llama 3.3 70B — 30 RPM, 14,400 requests/day free
EXPO_PUBLIC_GROQ_API_KEY=your-groq-api-key

# ─── Google Gemini (AI Chatbot - alternative) ────────────────
# Get a free key at: https://aistudio.google.com/apikey
# Note: Free tier may not work in all regions (India requires billing)
EXPO_PUBLIC_GEMINI_API_KEY=your-gemini-api-key

# ─── WhatsApp ────────────────────────────────────────────────
# The nursery's WhatsApp number (with country code, e.g., 919876543210)
EXPO_PUBLIC_WHATSAPP_PHONE=your-whatsapp-number
